nextflow_process {

    name "Test Process ARIBA_RUN"
    script "../main.nf"
    process "ARIBA_RUN"
    config "./nextflow.config"

    tag "modules"
    tag "modules_nfcore"
    tag "ariba"
    tag "ariba/run"
    tag "ariba/getref"

    test("sarscov2 illumina  paired-end [fastq]") {

        setup {
            run("ARIBA_GETREF") {
                    script "../../../ariba/getref/main.nf"
                    process {
                        """
                        input[0] = [ [ id:'test' ], // meta map
                            "card"
                            ]
                        """
                    }
                }
        }
        when {
            process {
                """

                input[0] = [ [ id:'test', single_end:false ], // meta map
                        [   file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true),
                            file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_2.fastq.gz', checkIfExists: true) ],
                        ]
                input[1] = ARIBA_GETREF.out.db
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    path(process.out.results[0][1][3]).readLines()[0],
                    path(process.out.results[0][1][4]).readLines()[0],
                    path(process.out.results[0][1][5]).readLines()[0],
                    process.out.results[0][1].collect{ file_path -> file(file_path).name }.sort(),
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }

    }

    test("sarscov2 illumina paired-end [fastq] - stub") {

        options "-stub"

        setup {
            run("ARIBA_GETREF") {
                    script "../../../ariba/getref/main.nf"
                    process {
                        """
                        input[0] = [ [ id:'test' ], // meta map
                            "card"
                            ]
                        """
                    }
                }
        }
        when {
            process {
                """

                input[0] = [ [ id:'test', single_end:false ], // meta map
                        [   file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true),
                            file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_2.fastq.gz', checkIfExists: true) ],
                        ]
                input[1] = ARIBA_GETREF.out.db
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }
}
